/**
 * This configuration file defines custom commands for the "rush" command-line.
 * More documentation is available on the Rush website: https://rushjs.io
 */
{
    "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/command-line.schema.json",

    /**
     * Custom "commands" introduce new verbs for the command-line.  To see the help for these
     * example commands, try "rush --help", "rush my-bulk-command --help", or
     * "rush my-global-command --help".
     */
    "commands": [
        {
            "commandKind": "global",
            "name": "sync",
            "summary": "Synchronizes Git submodules from projects.json.",
            "description": "Reads config/projects.json and creates or updates Git submodules.",
            "shellCommand": "node common/scripts/sync-submodules.js"
        },
        {
            "commandKind": "bulk",
            "name": "start",
            "summary": "Starts all applications.",
            "description": "Runs the start script for each Rush project.",
            "enableParallelism": true
        },
        {
            "commandKind": "global",
            "name": "preview",
            "summary": "Starts preview servers for all React apps.",
            "shellCommand": "node common/scripts/preview-apps.js"
        },
        {
            "commandKind": "global",
            "name": "docker:build",
            "summary": "Builds Docker images in parallel for projects in deploy.json.",
            "description": "Reads deploy.json and builds container images with concurrency throttling.",
            "shellCommand": "node common/scripts/build-images.js"
        }
    ],

    /**
     * Custom "parameters" introduce new parameters for specified Rush command-line commands.
     * For example, you might define a "--production" parameter for the "rush build" command.
     */
    "parameters": [
        {
            "parameterKind": "flag",
            "longName": "--changed-only",
            "description": "Only build Docker images for projects that have git changes.",
            "associatedCommands": ["docker:build"]
        },
        {
            "parameterKind": "flag",
            "longName": "--push",
            "description": "Push the built Docker images to the container registry.",
            "associatedCommands": ["docker:build"]
        },
        {
            "parameterKind": "flag",
            "longName": "--single",
            "description": "Build Docker images sequentially one-by-one with no parallelism.",
            "associatedCommands": ["docker:build"]
        }
    ]
}
